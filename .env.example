# Copy to .env.local and fill in.

# Neon Postgres. `neon env pull` (or `neon deploy`) writes these into .env.local.
# DATABASE_URL is the pooled URL for the app; DATABASE_URL_UNPOOLED is the direct URL for migrations.
# Leave both empty to use the embedded local database in .data/pglite.
DATABASE_URL=
DATABASE_URL_UNPOOLED=
NEON_BRANCH=

# Better Auth. Generate a secret with: openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Resend (server only). Set both to enable verification and password reset emails.
# Use an address on a domain verified in Resend.
RESEND_API_KEY=
EMAIL_FROM=
# Secures /api/cron/email; generate at least 32 random bytes.
CRON_SECRET=

# Optional Google sign-in
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Encrypts stored intervals.icu API keys. 32 bytes, base64: openssl rand -base64 32
ENCRYPTION_KEY=

# Development only: your intervals.icu key for `pnpm intervals:check` and `pnpm dev:seed`,
# and the throwaway account `pnpm dev:seed` creates (delete it with `pnpm dev:seed --delete`).
INTERVALS_DEV_API_KEY=
DEV_TEST_EMAIL=
DEV_TEST_PASSWORD=
