# Copy to .env.neon-email (gitignored). These values are deployed only to Neon.
# Use the canonical production origin, with no path or query string.
CRON_TARGET_URL=https://your-app.example.com
# Must exactly match CRON_SECRET in Vercel production.
CRON_SECRET=
# Keep false until the authenticated /api/cron/email?check=1 probe succeeds.
EMAIL_CRON_ENABLED=false
